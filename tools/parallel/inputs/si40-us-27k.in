! si40-27k.in on an ultrasoft dataset: 27 k-points whose projectors every pool holds in store mode.
! The cubic cell of si8-1k-ecut30.in stacked five deep along z (ibrav 6, c/a = 5),
! at the production cutoff of the other *-ecut30 cells. nosym and noinv keep the
! whole unshifted grid, 27 points, which is what a magnetic spin-orbit run without
! symmetry would have to walk; the point is the number of k-points and the size of
! each one, not the physics of silicon. 160 electrons, 80 bands.
 &control
    outdir = './tmp', prefix = 'si40-us-27k',
    calculation = 'scf'
 /
 &system
    ibrav=6, celldm(1) =10.20, celldm(3) =5.0,
    nat=40, ntyp=1,
    ecutwfc=30.0, ecutrho=240.0,
    nosym = .true., noinv = .true.
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-n-rrkjus_psl.0.1.UPF
ATOMIC_POSITIONS crystal
 Si  0.00000  0.00000  0.00000
 Si  0.00000  0.50000  0.10000
 Si  0.50000  0.00000  0.10000
 Si  0.50000  0.50000  0.00000
