! The collinear half of the si8-nc-1k pair: same cell, same smearing, npol = 1.
 &control
    calculation = 'scf'
 /
 &system
    ibrav=1, celldm(1) =10.20,
    nat=8, ntyp=1,
    ecutwfc=12.0
    occupations='smearing', smearing='gaussian', degauss=0.02
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Si 0.00 0.00 0.00
 Si 0.00 0.50 0.50
 Si 0.50 0.00 0.50
 Si 0.50 0.50 0.00
 Si 0.25 0.25 0.25
 Si 0.25 0.75 0.75
 Si 0.75 0.25 0.75
 Si 0.75 0.75 0.25
K_POINTS
  1
   0.250000  0.250000  0.250000   1.00
