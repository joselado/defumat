__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
# QE reference tree: vendored, large, and read-only. Kept out of the repo.
quantum_espresso/
# scratch run outputs
out/
*.save/
# Session working files: the diagnostic harnesses a phase was debugged with,
# the handoff note, and the resumable regression summaries. None of them is a
# deliverable -- what a phase established goes in PLAN.md and in a test.
scratchpad/
NEXT-SESSION.md
regression-results*/

# Generated by performance/run_performance.py -- one machine, one day.
performance/performance.tex
performance/performance.pdf
performance/performance.json
performance/*.aux
performance/*.log

# xelatex's build products for docs/features.tex. The PDF is committed
# (docs/features.pdf); these are regenerated by every build.
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.listing
performance/*.out

# Claude Code agent worktrees
.claude/worktrees/

# Machine- and site-specific working context: cluster access policy, account
# paths, private notes. Kept beside the checkout, never in a public repository.
*.local.md
regression-results/

# xelatex build products for slides/defumat.tex. The PDF is committed.
slides/*.aux
slides/*.log
slides/*.nav
slides/*.out
slides/*.snm
slides/*.toc
