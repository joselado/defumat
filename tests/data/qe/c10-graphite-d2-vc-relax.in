! **Ten atoms and a cell that has to change shape.** Five graphene layers in AB
! stacking with `vdw_corr = 'grimme-d2'` -- `c10-graphite-d2.in`'s crystal --
! relaxed with `calculation = 'vc-relax'` instead of held at experiment.
!
! This is the case the cell's *nine* coordinates exist for. A cubic crystal
! under pressure moves one of them, the volume, and eight are along for the
! ride; graphite's `c` and `a` are independent, and they respond to completely
! different physics: `a` is the covalent in-plane bond, stiff and already
! nearly right, while `c` is held only by the dispersion correction -- PBE alone
! has no minimum along it at all (P27). So a relaxation that got the cell block
! wrong in a way an isotropic case cannot see moves them together.
!
! The starting `celldm(3) = 6.805` is experiment (3.35 A interlayer), which the
! scf case uses precisely because it is *not* relaxed; here it is the starting
! point and the relaxed value is the answer. The atoms sit at exact fifths, so
! the structure factor vanishes exactly at 2 in 5 of the G-vectors along the
! stacking axis -- P28a's regime, with the stress and the cell gradient as the
! new consumers of it.
!
! `cell_dofree = 'all'`: the hexagonal symmetry is what keeps `a = b` and the
! angles fixed, not a constraint in the input, so the run is also a check that
! the symmetrised stress cannot break its own point group.
 &control
    calculation = 'vc-relax'
    tprnfor = .true.
    tstress = .true.
 /
 &system
    ibrav = 4
    celldm(1) = 4.6511
    celldm(3) = 6.805468080128
    nat = 10
    ntyp = 1
    ecutwfc = 40
    occupations = 'smearing'
    smearing = 'marzari-vanderbilt'
    degauss = 0.02
    vdw_corr = 'grimme-d2'
 /
 &electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.5
 /
 &ions
 /
 &cell
    cell_dynamics = 'bfgs'
    press = 0.0
 /
ATOMIC_SPECIES
 C 12.011 C.pbe-hgh.UPF
ATOMIC_POSITIONS crystal
 C 0.000000000000 0.000000000000 0.000000000000
 C 0.333333333333 0.666666666667 0.000000000000
 C 0.000000000000 0.000000000000 0.200000000000
 C 0.666666666667 0.333333333333 0.200000000000
 C 0.000000000000 0.000000000000 0.400000000000
 C 0.333333333333 0.666666666667 0.400000000000
 C 0.000000000000 0.000000000000 0.600000000000
 C 0.666666666667 0.333333333333 0.600000000000
 C 0.000000000000 0.000000000000 0.800000000000
 C 0.333333333333 0.666666666667 0.800000000000
K_POINTS automatic
 6 6 1 0 0 0
