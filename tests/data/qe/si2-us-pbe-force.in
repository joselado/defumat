! The displaced silicon of si2-us-force.in with PBE instead of LDA.
!
! The gradient correction reaches the force twice over: through the
! exchange-correlation energy of the moving density, and through the core charge
! that a gradient-corrected functional differentiates alongside it.
 &control
    calculation = 'scf'
    tprnfor = .true.
    verbosity = 'high'
 /
 &system
    ibrav=2, celldm(1)=10.20, nat=2, ntyp=1,
    ecutwfc=20.0, ecutrho=160.0
 /
 &electrons
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 Si  28.086  Si.pbe-n-rrkjus_psl.0.1.UPF
ATOMIC_POSITIONS (alat)
 Si 0.00 0.00 0.00
 Si 0.27 0.25 0.25
K_POINTS (automatic)
 4 4 4 0 0 0
