! Trigonal selenium without spin-orbit coupling: `se-trigonal-soc.in` with SG15's
! scalar-relativistic `Se.pbe-nc-sg15` and no spinors, the same crystal, cutoff and
! mesh, so that what differs between the two runs is the coupling and the dataset's
! scalar-relativistic counterpart, both from the SG15 set.
 &control
    calculation = 'scf'
    prefix = 'se'
 /
 &system
    ibrav = 4, celldm(1) = 8.2509, celldm(3) = 1.1345,
    nat = 3, ntyp = 1,
    ecutwfc = 20.0,
    nosym = .true., noinv = .true.,
 /
 &electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.5
 /
ATOMIC_SPECIES
 Se 78.97 Se.pbe-nc-sg15.UPF
ATOMIC_POSITIONS (crystal)
 Se  0.2254  0.0000  0.333333333
 Se  0.0000  0.2254  0.666666667
 Se -0.2254 -0.2254  0.000000000
K_POINTS (automatic)
 2 2 2 0 0 0
