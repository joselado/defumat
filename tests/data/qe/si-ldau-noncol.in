&control
      calculation = 'scf'
   /
   &system
      ibrav = 2
      celldm(1) = 10.2
      nat = 2
      ntyp = 1
      ecutwfc = 12.0
      occupations = 'smearing'
      smearing = 'gauss'
      degauss = 0.02
      noncolin = .true.
      starting_magnetization(1) = 0.4
      angle1(1) = 0.0
      angle2(1) = 0.0
   /
   &electrons
      conv_thr = 1.d-10
      mixing_beta = 0.4
      electron_maxstep = 200
   /
   ATOMIC_SPECIES
   Si 28.086 Si.pz-vbc.UPF
   ATOMIC_POSITIONS crystal
   Si  0.00  0.00  0.00
   Si  0.25  0.25  0.25
   K_POINTS automatic
   4 4 4 0 0 0
   HUBBARD atomic
   U   Si-3p   2.5
