! Bilayer graphene at the geometry defumat's own relaxation settles on
! (`graphene-bilayer-d2-relax.in`), so that `pw.x` can be asked whether it is a
! stationary point of *its* surface -- which is the only curvature-free way to
! compare two relaxations on a van der Waals potential this flat. It is: pw.x
! gives the same total energy to 1e-8 Ry and a force of 3e-6 Ry/bohr here, where
! its own BFGS stopped 0.48 bohr away and 8e-4 Ry higher.
&control
 calculation = 'scf'
 verbosity = 'high'
 tprnfor = .true.
 tstress = .true.
/
&system
 ibrav = 4
 celldm(1) = 4.6511
 celldm(3) = 4.3
 nat = 4
 ntyp = 1
 ecutwfc = 40
 occupations = 'smearing'
 smearing = 'marzari-vanderbilt'
 degauss = 0.02
 vdw_corr = 'grimme-d2'
/
&electrons
 conv_thr = 1.0d-10
 mixing_beta = 0.5
/
ATOMIC_SPECIES
 C 12.011 C.pbe-hgh.UPF
ATOMIC_POSITIONS crystal
 C 0.000000000000 0.000000000000 0.347406720000
 C 0.333333333333 0.666666666667 0.347291060000
 C 0.000000000000 0.000000000000 0.652593280000
 C 0.666666666667 0.333333333333 0.652708940000
K_POINTS automatic
 12 12 1 0 0 0
