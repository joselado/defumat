! `pt2-soc-force.in` with **PAW**, so the one-centre terms move with the atoms.
!
! The same doubled fcc platinum cell and the same displaced atom, on
! `pw_spinorbit/spinorbit-paw.in`'s fully-relativistic PAW dataset (and
! therefore PBE). PAW adds nothing to the spinor force that has a routine of
! its own: `becsum` reaches the energy through `onecenter` and `deeq`, so
! differentiating the same functional carries it -- which is exactly the claim
! this case checks against `pw.x`.
 &control
    calculation = 'scf'
    tprnfor = .true.
    tstress = .true.
    verbosity = 'high'
 /
 &system
    ibrav = 0, celldm(1) = 7.42,
    nat = 2, ntyp = 1,
    lspinorb = .true.,
    noncolin = .true.,
    starting_magnetization = 0.0,
    occupations = 'smearing', smearing = 'mp', degauss = 0.02,
    ecutwfc = 30.0, ecutrho = 250.0,
 /
 &electrons
    conv_thr = 1.0d-10
 /
CELL_PARAMETERS alat
  -1.000000000000  0.000000000000  1.000000000000
   0.000000000000  0.500000000000  0.500000000000
  -0.500000000000  0.500000000000  0.000000000000
ATOMIC_SPECIES
 Pt  195.08  Pt.rel-pbe-n-kjpaw_psl.0.1.UPF
ATOMIC_POSITIONS (crystal)
 Pt 0.00 0.00 0.00
 Pt 0.53 0.00 0.00
K_POINTS AUTOMATIC
 2 4 4 0 0 0
