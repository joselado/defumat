! The same oxygen chain in a cell doubled along z, with the two atoms' moments
! antiparallel: the supercell the spiral at spiral_q = (0, 0, 1/2) must
! reproduce, computed by the collinear LSDA path.
!
! The k-grid is half the primitive one along z, which is the exact folding.
!
! **This reference is collinear and the primitive is not**, so the two sides do
! not share the noncollinear machinery, and the residue this identity leaves is
! that gap rather than the spiral's -- measured, with the spiral taken out
! entirely, in tests/regression/test_spin_spirals_augmented.py. The 90-degree
! supercell is the same-machinery version and is the sharp one.
 &control
    calculation = 'scf'
 /
 &system
    ibrav = 6, celldm(1) = 12.0, celldm(3) = 0.86666666666667,
    nat = 2, ntyp = 2,
    ecutwfc = 25.0, ecutrho = 200.0,
    occupations = 'smearing', smearing = 'gaussian', degauss = 0.10
    nspin = 2
    nosym = .true.
    starting_magnetization(1) =  0.6
    starting_magnetization(2) = -0.6
    nbnd = 20
 /
 &electrons
    mixing_beta = 0.3
    conv_thr = 1.0d-10
 /
ATOMIC_SPECIES
 O1  16.0  O.pz-kjpaw.UPF
 O2  16.0  O.pz-kjpaw.UPF
ATOMIC_POSITIONS (crystal)
 O1 0.0 0.0 0.0
 O2 0.0 0.0 0.5
K_POINTS {automatic}
 1 1 2 0 0 0
