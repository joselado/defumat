! `si10-nc-anisotropic.in` with the symmetry switched off: all sixteen points
! of the 4x4x1 grid, no symmetrisation of the density, and therefore no question
! about what a reduced set contains. It is the arbiter for the 6.9e-5 Ry the
! other file records, and it is committed rather than quoted so that the claim
! can be rerun.
 &control
    calculation = 'scf'
    tprnfor = .true.
    tstress = .true.
 /
 &system
    ibrav = 0, celldm(1) = 10.20, nat = 10, ntyp = 1,
    ecutwfc = 12.0
    nosym = .true.
    noinv = .true.
 /
 &electrons
    conv_thr = 1.0d-10
 /
CELL_PARAMETERS alat
  -0.50  0.00  0.50
   0.00  0.50  0.50
  -2.50  2.50  0.00
ATOMIC_SPECIES
 Si  28.086  Si.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
 Si    0.0000    0.0000    0.0000
 Si    0.2500    0.2500    0.2900
 Si   -0.5000    0.5000    0.0000
 Si   -0.2500    0.7500    0.2500
 Si   -1.0000    1.0000    0.0000
 Si   -0.7500    1.2500    0.2500
 Si   -1.5000    1.5000    0.0000
 Si   -1.2500    1.7500    0.2500
 Si   -2.0000    2.0000    0.0000
 Si   -1.7500    2.2500    0.2500
K_POINTS automatic
 4 4 1 0 0 0
