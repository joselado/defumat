! 1H-NbSe2 monolayer, reduced for a notebook and for the test suite.
!
! The production input is calculations/nbse2-fermi-surface/nbse2.in, which is
! the same cell at ecutwfc = 60 on a 12x12x1 grid. This one is ecutwfc = 40 on
! 9x9x1 -- 9 is a multiple of 3, so the zone corner K is on the mesh, which is
! what a momentum-resolved quantity needs.
!
! Structure: the 2H bulk (a = 3.442 A) with one layer kept and 18 A of cell
! height. The Se in-plane pair is the source refinement's truncated
! 0.3333/0.6667 rather than exact thirds, which breaks the three-fold and
! leaves 4 symmetry operations out of the lattice's 24.
 &control
    calculation = 'scf'
    prefix = 'nbse2'
 /
 &system
    ibrav = 4, celldm(1) = 6.5044373210, celldm(3) = 5.2295177223,
    nat = 3, ntyp = 2,
    ecutwfc = 40.0,
    occupations = 'smearing', smearing = 'fermi-dirac', degauss = 0.002,
    nbnd = 20,
 /
 &electrons
    conv_thr = 1.0d-8
 /
ATOMIC_SPECIES
 Nb  92.906  Nb.pbe-nc-sg15.UPF
 Se  78.971  Se.pbe-nc-sg15.UPF
ATOMIC_POSITIONS (crystal)
 Nb  0.0000000000  0.0000000000  0.5000000000
 Se  0.3333000000  0.6667000000  0.5933533333
 Se  0.3333000000  0.6667000000  0.4066466667
K_POINTS {automatic}
 9 9 1 0 0 0
