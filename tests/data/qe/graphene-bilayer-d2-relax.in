&control
 calculation = 'relax'
 tprnfor = .true.
 forc_conv_thr = 1.0d-5
 etot_conv_thr = 1.0d-8
/
&system
 ibrav = 4
 celldm(1) = 4.6511
 celldm(3) = 4.3
 nat = 4
 ntyp = 1
 ecutwfc = 40
 occupations = 'smearing'
 smearing = 'marzari-vanderbilt'
 degauss = 0.02
 vdw_corr = 'grimme-d2'
/
&electrons
 conv_thr = 1.0d-10
 mixing_beta = 0.5
/
&ions
/
ATOMIC_SPECIES
 C 12.011 C.pbe-hgh.UPF
ATOMIC_POSITIONS crystal
 C 0.000000 0.000000 0.320000 0 0 1
 C 0.333333333333 0.666666666667 0.320000 0 0 1
 C 0.000000 0.000000 0.680000 0 0 1
 C 0.666666666667 0.333333333333 0.680000 0 0 1
K_POINTS automatic
 12 12 1 0 0 0
